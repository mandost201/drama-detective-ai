# Drama Detective AI - environment variables (copy to .env, never commit)
# Everything is optional: the app works with no keys at all.

# YouTube Data API v3 key. If set, playlist metadata is read through the
# official API; if empty, the app falls back to yt-dlp (no key needed).
# Captions always come from publicly accessible caption tracks.
YOUTUBE_API_KEY=

# Whisper model for transcribing episodes that have no captions, and for
# clip/upload transcription. tiny|base|small (bigger = slower, better).
WHISPER_MODEL=tiny

# fastembed model for semantic (meaning) search.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ingestion politeness / parallelism
TRANSCRIPT_WORKERS=4
REQUEST_DELAY=0.4
MAX_VIDEOS_PER_PLAYLIST=500

# Set to 1 to automatically Whisper-transcribe every caption-less episode
# during playlist analysis. Default (unset): captions are indexed first
# for fast results; transcription is started from the UI when wanted.
AUTO_TRANSCRIBE_MISSING=

# FastAPI layer only (backend/app.py)
HOST=0.0.0.0
PORT=8000
